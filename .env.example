# Transport Pro public API (used for reading loads/files and uploading the Rate Confirmation)
TPRO_BASE_URL=https://cli.transportpro.net/publicapi/v1
TPRO_USERNAME=
TPRO_PASSWORD=

# Zeus (SDI Supplier Portal) - the existing lowercase keys are also accepted:
# link= / username= / password=
ZEUS_URL=https://supplierportal.sdi.com/signin
ZEUS_USERNAME=
ZEUS_PASSWORD=

# Optional tuning
PORC_CUSTOMER_ID=8828
PORC_LOOKBACK_DAYS=14
# Go-live date: loads delivered before this day are never processed (YYYY-MM-DD)
PORC_START_DATE=2026-10-28
# Loads whose Freight Bill total is below this amount are skipped (a $0 freight bill never gets a Rate Confirmation)
PORC_MIN_FREIGHT=0.01
PORC_REQUESTED_BY_DEFAULT=
PORC_HEADLESS=true
PORC_STRICT_STORE_MATCH=false

# Transport Pro Postgres replica (read-only; source of the load "Internal Comments" = Zeus Requested By)
TPRO_DB_HOST=
TPRO_DB_PORT=5432
TPRO_DB_NAME=
TPRO_DB_USER=
TPRO_DB_PASSWORD=
